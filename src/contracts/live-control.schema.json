{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fisch Live command extension",
  "type": "object", "additionalProperties": false, "required": ["type", "program", "configuration"],
  "properties": {
    "type": { "const": "live" },
    "program": { "description": "Legacy program AST, validated by the shared compiler; null keeps geometry", "type": ["object", "null"] },
    "configuration": { "$ref": "#/$defs/configuration" }
  },
  "$defs": {
    "target": { "type": "object", "additionalProperties": false, "required": ["part", "prop"], "properties": {
      "part": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,32}$" },
      "prop": { "enum": ["x", "y", "z", "rotateX", "rotateY", "rotateZ", "scaleX", "scaleY", "scaleZ"] } } },
    "pose": { "type": "object", "additionalProperties": false, "required": ["type", "target", "value", "durationMs"], "properties": {
      "type": { "const": "pose" }, "target": { "$ref": "#/$defs/target" }, "value": { "type": "number", "minimum": -0.6, "maximum": 2 },
      "durationMs": { "type": "integer", "minimum": 100, "maximum": 10000 },
      "delayMs": { "type": "integer", "minimum": 0, "maximum": 9900 },
      "attackMs": { "type": "integer", "minimum": 20, "maximum": 10000 },
      "releaseMs": { "type": "integer", "minimum": 20, "maximum": 10000 } } },
    "bind": { "type": "object", "additionalProperties": false, "required": ["type", "id", "signal", "target", "gain", "offset", "clamp", "smoothMs"], "properties": {
      "type": { "const": "bind" }, "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,32}$" },
      "signal": { "enum": ["agent.output", "user.head.yaw", "user.head.pitch", "user.position.x", "user.position.y", "hand.primary.position.x", "hand.primary.position.y", "user.expression.smile", "user.expression.browRaise", "user.expression.eyesClosed", "user.expression.mouthOpen", "user.mouthMoving"] },
      "target": { "$ref": "#/$defs/target" }, "gain": { "type": "number", "minimum": -4, "maximum": 4 }, "offset": { "type": "number", "minimum": -0.6, "maximum": 2 },
      "clamp": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": -0.6, "maximum": 2 } },
      "smoothMs": { "type": "number", "minimum": 40, "maximum": 2000 } } },
    "orient": { "type": "object", "additionalProperties": false, "required": ["type", "id", "part", "toward", "maxDeg", "smoothMs"], "properties": {
      "type": { "const": "orient" }, "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,32}$" }, "part": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,32}$" },
      "toward": { "type": "object", "additionalProperties": false, "required": ["entity"], "properties": { "entity": { "const": "user" } } },
      "maxDeg": { "type": "number", "minimum": 0, "maximum": 30 }, "smoothMs": { "type": "number", "minimum": 40, "maximum": 2000 } } },
    "reflex": { "type": "object", "additionalProperties": false, "required": ["type", "id", "when", "do", "cooldownMs"], "properties": {
      "type": { "const": "reflex" }, "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,32}$" },
      "when": { "type": "object", "additionalProperties": false, "required": ["event"], "properties": { "event": { "enum": ["user_arrived", "user_left", "looked_away", "looked_back", "expression_changed", "mouth_started", "mouth_stopped", "turn_changed"] } } },
      "do": { "$ref": "#/$defs/pose" }, "cooldownMs": { "type": "number", "minimum": 500, "maximum": 300000 } } },
    "configuration": { "type": "object", "additionalProperties": false, "required": ["controls", "poses", "lifetimeMs"], "properties": {
      "controls": { "type": "array", "maxItems": 32, "items": { "oneOf": [{ "$ref": "#/$defs/bind" }, { "$ref": "#/$defs/orient" }, { "$ref": "#/$defs/reflex" }] } },
      "poses": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/pose" } }, "lifetimeMs": { "type": "number", "minimum": 1000, "maximum": 300000 }, "observerHandoffMs": { "type": "integer", "minimum": 1000, "maximum": 60000, "description": "Explicit one-shot permission to replace this disposable MAIN body after its lease. No overlay or restoration. Window expires; new intent/reset revokes." } } }
  }
}
