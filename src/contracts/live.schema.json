{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fisch Live observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "sessionId", "seq", "capturedAt", "camera", "user", "turn", "summary"],
  "properties": {
    "v": { "const": 1 },
    "sessionId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$" },
    "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "capturedAt": { "type": "number", "minimum": 0 },
    "camera": { "enum": ["starting", "tracking", "absent", "denied", "error", "stopped", "stale"] },
    "turn": { "enum": ["idle", "working", "waiting", "interrupted"] },
    "summary": { "type": "string", "maxLength": 400, "pattern": "^[^\\u0000-\\u001f\\u007f]*$" },
    "user": {
      "type": "object", "additionalProperties": false,
      "required": ["present", "quality", "position", "head", "facingScreen", "expression", "mouthMoving"],
      "properties": {
        "present": { "type": "boolean" },
        "quality": { "type": "object", "additionalProperties": false, "required": ["score", "basis"],
          "properties": { "score": { "type": "number", "minimum": 0, "maximum": 1 }, "basis": { "enum": ["tracking-stability", "unavailable"] } } },
        "position": { "anyOf": [{ "$ref": "#/$defs/position" }, { "type": "null" }] },
        "head": { "anyOf": [{ "$ref": "#/$defs/head" }, { "type": "null" }] },
        "expression": { "anyOf": [{ "$ref": "#/$defs/expression" }, { "type": "null" }] },
        "facingScreen": { "type": ["boolean", "null"] },
        "mouthMoving": { "type": ["boolean", "null"] }
      }
    }
  },
  "$defs": {
    "position": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {
      "x": { "type": "number", "minimum": -1, "maximum": 1 }, "y": { "type": "number", "minimum": -1, "maximum": 1 } } },
    "head": { "type": "object", "additionalProperties": false, "required": ["yaw", "pitch", "roll"], "properties": {
      "yaw": { "type": "number", "minimum": -180, "maximum": 180 }, "pitch": { "type": "number", "minimum": -180, "maximum": 180 }, "roll": { "type": "number", "minimum": -180, "maximum": 180 } } },
    "expression": { "type": "object", "additionalProperties": false, "required": ["smile", "browRaise", "eyesClosed", "mouthOpen"], "properties": {
      "smile": { "type": "number", "minimum": 0, "maximum": 1 }, "browRaise": { "type": "number", "minimum": 0, "maximum": 1 },
      "eyesClosed": { "type": "number", "minimum": 0, "maximum": 1 }, "mouthOpen": { "type": "number", "minimum": 0, "maximum": 1 } } }
  }
}
